<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AngleSharp.Renderer</AssemblyName>
    <RootNamespace>AngleSharp.Renderer</RootNamespace>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <PackageProjectUrl>https://anglesharp.github.io</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>html;html5;css;css3;dom;rendering;canvas;library;anglesharp;angle</PackageTags>
    <PackageReleaseNotes>https://github.com/AngleSharp/AngleSharp.Renderer/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/AngleSharp/AngleSharp.Renderer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AngleSharpVersion Condition=" '$(AngleSharpVersion)' == '' ">1.11.0</AngleSharpVersion>
    <AngleSharpCssVersion Condition=" '$(AngleSharpCssVersion)' == '' ">1.6.0</AngleSharpCssVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.156.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.156.1" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.4.0.101" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/Fonts/*.ttf" />
    <None Include="Resources/Fonts/*-OFL.txt" Pack="true" PackagePath="licenses/" />
  </ItemGroup>

  <!-- TEMPORARY while the DOM registration contract (AngleSharp.Scripting.DomRegistry) and its
       generator are developed in AngleSharp.Core: build against the sibling checkout. Revert to the
       package reference, with AngleSharpVersion raised to the release shipping them, before merging;
       the package brings the generator as an analyzer by itself. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\AngleSharp.Core\src\AngleSharp\AngleSharp.Core.csproj" />
    <ProjectReference Include="..\..\..\AngleSharp.Css\src\AngleSharp.Css\AngleSharp.Css.csproj" />
    <ProjectReference Include="..\..\..\AngleSharp.Core\src\AngleSharp.Generators\AngleSharp.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\logo.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
    </AssemblyAttribute>
    <!-- the DOM of this library for a scripting engine, without reflection: RendererDom.Register -->
    <AssemblyAttribute Include="AngleSharp.Attributes.GenerateDomRegistrationAttribute">
      <_Parameter1>AngleSharp.Renderer.RendererDom</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <DelaySign>false</DelaySign>
  </PropertyGroup>
</Project>
